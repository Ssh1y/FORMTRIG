+  u8 *buf = ck_alloc(len);
+  int fd = open(path, O_RDONLY);
+  if (fd < 0) {
+
+    ck_free(buf);
+    return NULL;
+
+  }
+
+  u32 got = 0;
+  while (got < len) {
+
+    ssize_t ret = read(fd, buf + got, len - got);
+    if (ret < 0) {
+
+      if (errno == EINTR) { continue; }
+      close(fd);
+      ck_free(buf);
+      return NULL;
+
+    }
+    if (!ret) { break; }
+    got += (u32)ret;
+
+  }
+
+  close(fd);
+  if (got != len) {
+
+    ck_free(buf);
+    return NULL;
+
+  }
+
+  *out_len = len;
+  return buf;
+
+}
+
+static u8 formtrig_make_temp_path(afl_state_t *afl, const char *suffix,
+                                  char *path, size_t path_len) {
+
+  const char *dir = afl && afl->tmp_dir ? (const char *)afl->tmp_dir : "/tmp";
+  int ret = snprintf(path, path_len, "%s/.formtrig_%s_%u_%llu_XXXXXX", dir,
+                     suffix ? suffix : "typed", getpid(),
+                     afl ? (unsigned long long)afl->fsrv.total_execs : 0ULL);
+  if (ret < 0 || (size_t)ret >= path_len) { return 0; }
+
+  int fd = mkstemp(path);
+  if (fd < 0) { return 0; }
+  close(fd);
+  return 1;
+
+}
+
+static u8 *formtrig_run_typed_mutation_hook(
+    afl_state_t *afl, const u8 *in_buf, const u8 *mut_buf, u32 len, u32 start,
+    u32 span, u32 off, u32 op, u32 sample, u32 hint_kind, u32 hint_value,
+    const formtrig_progress_component_t *component, u32 *hook_len) {
+
+  *hook_len = 0;
+  const char *hook = formtrig_typed_mutation_hook();
+  if (!hook) { return NULL; }
+
+  char orig_path[PATH_MAX], mut_path[PATH_MAX], out_path[PATH_MAX];
+  orig_path[0] = mut_path[0] = out_path[0] = '\0';
+  if (!formtrig_make_temp_path(afl, "orig", orig_path, sizeof(orig_path)) ||
+      !formtrig_make_temp_path(afl, "mut", mut_path, sizeof(mut_path)) ||
+      !formtrig_make_temp_path(afl, "out", out_path, sizeof(out_path))) {
+
+    if (orig_path[0]) { unlink(orig_path); }
+    if (mut_path[0]) { unlink(mut_path); }
+    if (out_path[0]) { unlink(out_path); }
+    return NULL;
+
+  }
+
+  u8 ok = formtrig_write_all_to_file(orig_path, in_buf, len) &&
+          formtrig_write_all_to_file(mut_path, mut_buf, len) &&
+          formtrig_write_all_to_file(out_path, (const u8 *)"", 0);
+  if (!ok) {
+
+    unlink(orig_path);
+    unlink(mut_path);
+    unlink(out_path);
+    return NULL;
+
+  }
+
+  char len_s[32], start_s[32], span_s[32], off_s[32], op_s[32], sample_s[32],
+      hint_kind_s[32], hint_value_s[32], kind_s[32], atom_s[32], role_s[32];
+  snprintf(len_s, sizeof(len_s), "%u", len);
+  snprintf(start_s, sizeof(start_s), "%u", start);
+  snprintf(span_s, sizeof(span_s), "%u", span);
+  snprintf(off_s, sizeof(off_s), "%u", off);
+  snprintf(op_s, sizeof(op_s), "%u", op);
+  snprintf(sample_s, sizeof(sample_s), "%u", sample);
+  snprintf(hint_kind_s, sizeof(hint_kind_s), "%u", hint_kind);
+  snprintf(hint_value_s, sizeof(hint_value_s), "%u", hint_value);
+  snprintf(kind_s, sizeof(kind_s), "%u", component ? component->kind : 0u);
+  snprintf(atom_s, sizeof(atom_s), "%u", component ? component->atom_id : 0u);
+  snprintf(role_s, sizeof(role_s), "%u", component ? component->role : 0u);
+
+  pid_t pid = fork();
+  if (pid == 0) {
+
+    execl(hook, hook, orig_path, mut_path, out_path, len_s, start_s, span_s,
+          off_s, op_s, sample_s, hint_kind_s, hint_value_s, kind_s, atom_s,
+          role_s, (char *)NULL);
+    _exit(127);
+
+  }
+
+  u8 success = 0;
+  if (pid > 0) {
+
+    int status = 0;
+    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+    success = WIFEXITED(status) && WEXITSTATUS(status) == 0;
+
+  }
+
+  u8 *hook_buf = NULL;
+  if (success) { hook_buf = formtrig_read_file_alloc(out_path, hook_len); }
+
+  unlink(orig_path);
+  unlink(mut_path);
+  unlink(out_path);
+  return hook_buf;
+
+}
+
+static u8 formtrig_fuzz_one_allow_heuristic_lift(void) {
+
+  return formtrig_fuzz_one_env_truthy(getenv("FORMTRIG_ALLOW_HEURISTIC_LIFT"));
+
+}
+
+static u8 formtrig_fuzz_one_allow_manual_lift(void) {
+
+  return formtrig_fuzz_one_env_truthy(getenv("FORMTRIG_ALLOW_MANUAL_LIFT"));
+
+}
+
+static u8 formtrig_fuzz_one_lower(const formtrig_progress_component_t *c) {
+
+  return (c->flags & FORMTRIG_COMPONENT_LOWER_IS_BETTER) != 0;
+
+}
+
+static u8 formtrig_fuzz_one_higher(const formtrig_progress_component_t *c) {
+
+  return (c->flags & FORMTRIG_COMPONENT_HIGHER_IS_BETTER) != 0;
+
+}
+
+static u8 formtrig_fuzz_one_actionable(
+    const formtrig_progress_component_t *c) {
+
+  if (!c) { return 0; }
+  if (!(c->flags & FORMTRIG_COMPONENT_TC_ROOTED)) { return 0; }
+  if (!formtrig_fuzz_one_finite(c->value) || c->value < 0.0) { return 0; }
+  /* Hot ranges guide typed mutations but do not make R-only states progress. */
+  if (c->flags & FORMTRIG_COMPONENT_INPUT_INFLUENCE) { return 0; }
+  if ((c->flags & FORMTRIG_COMPONENT_LIFTED) &&
+      !(c->flags & FORMTRIG_COMPONENT_NATIVE)) {
+
+    if (!c->atom_id) { return 0; }
+    if (c->flags & FORMTRIG_COMPONENT_SPEC_LIFTED) {
+      /* FORMTRIG-main: BindingSpec-generated TC-root progress. */
+    } else if (c->flags & FORMTRIG_COMPONENT_HEURISTIC_LIFTED) {
+      if (!formtrig_fuzz_one_allow_heuristic_lift()) { return 0; }
+    } else if (c->flags & FORMTRIG_COMPONENT_MANUAL_TARGET) {
+      if (!formtrig_fuzz_one_allow_manual_lift()) { return 0; }
+    } else {
+      return 0;
+    }
+
+  }
+  if (!formtrig_fuzz_one_finite(c->confidence) || c->confidence <= 0.0) {
+
+    return 0;
+
+  }
+
+  u8 lower = formtrig_fuzz_one_lower(c);
+  u8 higher = formtrig_fuzz_one_higher(c);
+  if (lower == higher) { return 0; }
+
+  if (lower && c->kind == FORMTRIG_COMPONENT_NATIVE_DISTANCE &&
+      (c->flags & FORMTRIG_COMPONENT_NATIVE) &&
+      c->value > 0.999999999 && c->value < 1.000000001) {
+
+    return 0;
+
+  }
+
+  return 1;
+
+}
+
+static u32 formtrig_fuzz_one_component_count(
+    const formtrig_queue_meta_t *m) {
+
+  if (!m) { return 0; }
+  u32 count = m->component_count;
+  return count > FORMTRIG_MAX_PROGRESS_COMPONENTS
+             ? FORMTRIG_MAX_PROGRESS_COMPONENTS
+             : count;
+
+}
+
+static u32 formtrig_typed_actionable_count(const formtrig_queue_meta_t *m) {
+
+  u32 actionable = 0;
+  u32 count = formtrig_fuzz_one_component_count(m);
+  for (u32 i = 0; i < count; ++i) {
+
+    if (formtrig_fuzz_one_actionable(&m->components[i])) { ++actionable; }
+
+  }
+
+  return actionable;
+
+}
+
+static const formtrig_progress_component_t *formtrig_typed_component(
+    const formtrig_queue_meta_t *m, u32 nth) {
+
+  u32 count = formtrig_fuzz_one_component_count(m);
+  for (u32 i = 0; i < count; ++i) {
+
+    const formtrig_progress_component_t *component = &m->components[i];
+    if (!formtrig_fuzz_one_actionable(component)) { continue; }
+    if (!nth--) { return component; }
+
+  }
+
+  return NULL;
+
+}
+
+static u8 formtrig_typed_retain_signal_eligible(
+    const formtrig_queue_meta_t *m) {
+
+  if (!m || !m->seen || !m->reached || m->triggered) { return 0; }
+  if (!(m->source_flags & FORMTRIG_SOURCE_SPEC_LIFTED) &&
+      !(m->observed_source_flags & FORMTRIG_SOURCE_SPEC_LIFTED)) {
+
+    return 0;
+
+  }
+  return formtrig_typed_actionable_count(m) ? 1 : 0;
+
+}
+
+static u8 formtrig_typed_retain_eligible(const formtrig_queue_meta_t *m,
+                                         u8 hook_used, u32 retain_mode) {
+
+  if (formtrig_typed_retain_signal_eligible(m)) { return 1; }
+  if (retain_mode == FORMTRIG_TYPED_RETAIN_MODE_HOOK) {
+
+    return hook_used ? 1 : 0;
+
+  }
+  if (retain_mode == FORMTRIG_TYPED_RETAIN_MODE_ALL) { return 1; }
+  return 0;
+
+}
+
+static u8 formtrig_typed_retain_append_record(
+    const char *record_path, const char *input_path, u32 source_queue_id,
+    u32 stage_cur, u32 op, u32 component_index, u32 range_index,
+    u32 sample_index, u32 start, u32 span, u32 off, u32 len, u8 hook_used,
+    const formtrig_progress_component_t *component,
+    const formtrig_queue_meta_t *signal) {
+
+  int fd = open(record_path, O_WRONLY | O_CREAT | O_APPEND, 0600);
+  if (fd < 0) { return 0; }
+
+  struct stat st;
+  if (!fstat(fd, &st) && st.st_size == 0) {
+
+    const char *header =
+        "path\tsource_queue_id\tstage_cur\top\tcomponent_index\t"
+        "range_index\tsample_index\tstart\tspan\toffset\tlen\thook_used\t"
+        "d_t\td_f_spec_lifted\ttrace_signature\tcomponent_kind\tatom_id\t"
+        "role\tcomponent_flags\tcomponent_value\thint_kind\thint_value\n";
+    if (!formtrig_write_all_fd(fd, header, strlen(header))) {
+
+      close(fd);
+      return 0;
+
+    }
+
+  }
+
+  char line[2048];
+  int  line_len = snprintf(
+      line, sizeof(line),
+      "%s\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%.17g\t%.17g\t"
+      "%016llx\t%u\t%u\t%u\t%u\t%.17g\t%u\t%u\n",
+      input_path, source_queue_id, stage_cur, op, component_index,
+      range_index, sample_index, start, span, off, len, hook_used,
+      signal && signal->seen ? signal->d_t : FORMTRIG_INF,
+      signal && signal->seen ? signal->d_f_spec_lifted : FORMTRIG_INF,
+      (unsigned long long)(signal && signal->seen ? signal->trace_signature
+                                                  : 0),
+      component ? component->kind : 0, component ? component->atom_id : 0,
+      component ? component->role : 0, component ? component->flags : 0,
+      component ? component->value : 0.0,
+      signal && signal->hot_range_count ? signal->hot_ranges[0].hint_kind : 0,
+      signal && signal->hot_range_count ? signal->hot_ranges[0].hint_value
+                                        : 0);
+
+  if (line_len <= 0 || (size_t)line_len >= sizeof(line)) {
+
+    close(fd);
+    return 0;
+
+  }
+
+  u8 ok = formtrig_write_all_fd(fd, line, (size_t)line_len);
+  if (close(fd)) { return 0; }
+  return ok;
+
+}
+
+static u8 formtrig_typed_retain_candidate(
+    afl_state_t *afl, const char *retain_dir, const u8 *buf, u32 len,
+    const formtrig_progress_component_t *component, u32 source_queue_id,
+    u32 stage_cur, u32 op, u32 component_index, u32 range_index,
+    u32 sample_index, u32 start, u32 span, u32 off, u32 retained_count,
+    u8 hook_used, u32 retain_mode) {
+
+  if (!retain_dir || !retain_dir[0] || !buf || !len) { return 0; }
+  if (!formtrig_typed_retain_eligible(&afl->formtrig_last, hook_used,
+                                      retain_mode)) {
+
+    return 0;
+
+  }
+  if (mkdir(retain_dir, 0700) && errno != EEXIST) { return 0; }
+
+  char input_path[PATH_MAX];
+  int  path_len = snprintf(input_path, sizeof(input_path),
+                           "%s/id:%06u,src:%06u,stage:%06u,op:%u,ci:%u,"
+                           "ri:%u,si:%u.bin",
+                           retain_dir, retained_count, source_queue_id,
+                           stage_cur, op, component_index, range_index,
+                           sample_index);
+  if (path_len <= 0 || path_len >= (int)sizeof(input_path)) { return 0; }
+
+  if (!formtrig_write_all_to_file(input_path, buf, len)) { return 0; }
+
+  char record_path[PATH_MAX];
+  path_len = snprintf(record_path, sizeof(record_path), "%s/records.tsv",
+                      retain_dir);
+  if (path_len <= 0 || path_len >= (int)sizeof(record_path)) { return 0; }
+
+  return formtrig_typed_retain_append_record(
+      record_path, input_path, source_queue_id, stage_cur, op, component_index,
+      range_index, sample_index, start, span, off, len, hook_used, component,
+      &afl->formtrig_last);
+
+}
+
+static u8 formtrig_hot_range_valid(const formtrig_hot_range_t *range,
+                                   u32 len, u32 *start, u32 *span,
+                                   u32 *hint_kind, u32 *hint_value) {
+
+  if (!range || !len || !range->len || range->start >= len) { return 0; }
+  if (!formtrig_fuzz_one_finite(range->influence) ||
+      range->influence <= 0.0) {
+
+    return 0;
+
+  }
+
+  u32 clipped = range->len;
+  if (clipped > len - range->start) { clipped = len - range->start; }
+  if (!clipped) { return 0; }
+  u32 window = formtrig_typed_range_window();
+  if (clipped > window) {
+
+    clipped = window;
+
+  }
+
+  *start = range->start;
+  *span = clipped;
+  if (hint_kind) { *hint_kind = range->hint_kind; }
+  if (hint_value) { *hint_value = range->hint_value; }
+  return 1;
+
+}
+
+static u32 formtrig_typed_native_hot_range_count(
+    const formtrig_queue_meta_t *m, u32 len) {
+
+  if (!m || !len) { return 0; }
+  u32 count = m->hot_range_count;
+  if (count > FORMTRIG_MAX_HOT_RANGES) { count = FORMTRIG_MAX_HOT_RANGES; }
+
+  u32 valid = 0;
+  for (u32 i = 0; i < count; ++i) {
+
+    u32 start = 0, span = 0;
+    if (formtrig_hot_range_valid(&m->hot_ranges[i], len, &start, &span,
+                                 NULL, NULL)) {
+
+      ++valid;
+
+    }
+
+  }
+
+  return valid;
+
+}
+
+static u32 formtrig_typed_fallback_hot_range_count(
+    const formtrig_queue_meta_t *m, u32 len) {
+
+  if (!m || !len || !m->lifted || !formtrig_typed_actionable_count(m)) {
+
+    return 0;
+
+  }
+
+  u32 ranges = formtrig_typed_fallback_ranges();
+  if (ranges > len) { ranges = len; }
+  return ranges;
+
+}
+
+static u8 formtrig_typed_fallback_hot_range(const formtrig_queue_meta_t *m,
+                                            u32 len, u32 nth, u32 *start,
+                                            u32 *span, u32 *hint_kind,
+                                            u32 *hint_value) {
+
+  u32 count = formtrig_typed_fallback_hot_range_count(m, len);
+  if (!count || nth >= count) { return 0; }
+
+  u32 window = formtrig_typed_range_window();
+  u32 clipped = len < window ? len : window;
+  if (!clipped) { return 0; }
+
+  u32 max_start = len - clipped;
+  u32 begin = 0;
+  if (count > 1 && max_start) {
+
+    begin = (u32)(((u64)nth * (u64)max_start) / (u64)(count - 1));
+
+  }
+
+  *start = begin;
+  *span = clipped;
+  if (hint_kind) { *hint_kind = FORMTRIG_MUTATION_HINT_NONE; }
+  if (hint_value) { *hint_value = 0; }
+  return 1;
+
+}
+
+static u8 formtrig_typed_hot_range(const formtrig_queue_meta_t *m, u32 len,
+                                   u32 nth, u32 *start, u32 *span,
+                                   u32 *hint_kind, u32 *hint_value) {
+
+  if (!m || !len) { return 0; }
+  u32 count = m->hot_range_count;
+  if (count > FORMTRIG_MAX_HOT_RANGES) { count = FORMTRIG_MAX_HOT_RANGES; }
+  u32 valid = 0;
+
+  for (u32 i = 0; i < count; ++i) {
+
+    if (!formtrig_hot_range_valid(&m->hot_ranges[i], len, start, span,
+                                  hint_kind, hint_value)) {
+
+      continue;
+
+    }
+
+    if (valid++ == nth) { return 1; }
+
+  }
+
+  if (valid) { return 0; }
+  return formtrig_typed_fallback_hot_range(m, len, nth, start, span, hint_kind,
+                                           hint_value);
+
+}
+
+static u16 formtrig_read16_le(const u8 *mem) {
+
+  return (u16)mem[0] | ((u16)mem[1] << 8);
+
+}
+
+static void formtrig_write16_le(u8 *mem, u16 v) {
+
+  mem[0] = (u8)v;
+  mem[1] = (u8)(v >> 8);
+
+}
+
+static u32 formtrig_read32_le(const u8 *mem) {
+
+  return (u32)mem[0] | ((u32)mem[1] << 8) | ((u32)mem[2] << 16) |
+         ((u32)mem[3] << 24);
+
+}
+
+static void formtrig_write32_le(u8 *mem, u32 v) {
+
+  mem[0] = (u8)v;
+  mem[1] = (u8)(v >> 8);
+  mem[2] = (u8)(v >> 16);
+  mem[3] = (u8)(v >> 24);
+
+}
+
+static u32 formtrig_typed_sample_offset(u32 start, u32 span, u32 sample,
+                                        u32 sample_count) {
+
+  if (span <= 1) { return start; }
+  if (sample_count <= 1) { return start; }
+  if (sample >= sample_count) { sample = sample_count - 1; }
+  return start + (u32)(((u64)sample * (u64)(span - 1)) /
+                       (u64)(sample_count - 1));
+
+}
+
+static void formtrig_apply_distance_mutation_at(u8 *out_buf, u32 len, u32 off,
+                                                u32 op) {
+
+  switch (op % FORMTRIG_TYPED_BUILTIN_OPS) {
+
+    case 0:
+      out_buf[off] ^= 0x01;
+      break;
+    case 1:
+      out_buf[off]++;
+      break;
+    case 2:
+      out_buf[off]--;
+      break;
+    case 3:
+      out_buf[off] = 0x00;
+      break;
+    case 4:
+      out_buf[off] = 0xff;
+      break;
+    case 5:
+      if (off + 1 < len) {
+
+        u16 v = formtrig_read16_le(out_buf + off);
+        formtrig_write16_le(out_buf + off, (u16)(v + 1));
+
+      } else {
+
+        out_buf[off] += 16;
+
+      }
+      break;
+    case 6:
+      if (off + 1 < len) {
+
+        u16 v = formtrig_read16_le(out_buf + off);
+        formtrig_write16_le(out_buf + off, (u16)(v - 1));
+
+      } else {
+
+        out_buf[off] -= 16;
+
+      }
+      break;
+    case 7:
+      if (off + 3 < len) {
+
+        u32 v = formtrig_read32_le(out_buf + off);
+        formtrig_write32_le(out_buf + off, v + ((op & 1) ? 16u : 1u));
+
+      } else {
+
+        out_buf[off] ^= 0x80;
+
+      }
+      break;
+    case 8:
+      if (off + 3 < len) {
+
+        u32 v = formtrig_read32_le(out_buf + off);
+        formtrig_write32_le(out_buf + off, v - ((op & 1) ? 16u : 1u));
+
+      } else {
+
+        out_buf[off] ^= 0x40;
+
+      }
+      break;
+    case 9:
+      if (off + 3 < len) {
+
+        formtrig_write32_le(out_buf + off, 0u);
+
+      } else {
+
+        out_buf[off] = 0;
+
+      }
+      break;
+    case 10:
+      if (off + 3 < len) {
+
+        formtrig_write32_le(out_buf + off, 0xffffffffu);
+
+      } else {
+
+        out_buf[off] = 0xff;
+
+      }
+      break;
+    default:
+      out_buf[off] ^= (u8)(0x80u >> (op & 7u));
+      break;
+
+  }
+
+}
+
+static void formtrig_fill_block(u8 *out_buf, u32 len, u32 off, u32 max_span,
+                                u32 block_len, u8 value) {
+
+  if (!len || off >= len) { return; }
+  if (!block_len) { block_len = 1; }
+  if (block_len > max_span) { block_len = max_span; }
+  if (block_len > len - off) { block_len = len - off; }
+  memset(out_buf + off, value, block_len);
+
+}
+
+static void formtrig_local_delete_like(u8 *out_buf, u32 len, u32 off,
+                                       u32 max_span, u32 block_len) {
+
+  if (!len || off >= len) { return; }
+  if (!block_len) { block_len = 1; }
+  if (block_len > max_span) { block_len = max_span; }
+  if (block_len > len - off) { block_len = len - off; }
+  if (!block_len) { return; }
+  if (off + block_len < len) {
+
+    memmove(out_buf + off, out_buf + off + block_len,
+            len - off - block_len);
+
+  }
+  memset(out_buf + len - block_len, 0, block_len);
+
+}
+
+static void formtrig_local_insert_like(u8 *out_buf, u32 len, u32 off,
+                                       u32 max_span, u32 block_len,
+                                       u8 value) {
+
+  if (!len || off >= len) { return; }
+  if (!block_len) { block_len = 1; }
+  if (block_len > max_span) { block_len = max_span; }
+  if (block_len > len - off) { block_len = len - off; }
+  if (!block_len) { return; }
+  if (off + block_len < len) {
+
+    memmove(out_buf + off + block_len, out_buf + off,
+            len - off - block_len);
+
+  }
+  memset(out_buf + off, value, block_len);
+
+}
+
+static void formtrig_apply_state_mutation_at(u8 *out_buf, u32 len, u32 start,
+                                             u32 span, u32 off, u32 op,
+                                             u32 sample) {
+
+  u32 block_len = 1u << ((sample + (op >> 2)) & 3u);
+
+  switch (op % FORMTRIG_TYPED_BUILTIN_OPS) {
+
+    case 0:
+      out_buf[off] ^= 0xff;
+      break;
+    case 1:
+      out_buf[off] ^= (u8)(1u << ((sample + op) & 7u));
+      break;
+    case 2:
+      out_buf[off] = 0x00;
+      break;
+    case 3:
+      out_buf[off] = 0xff;
+      break;
+    case 4:
+      out_buf[off]++;
+      break;
+    case 5:
+      out_buf[off]--;
+      break;
+    case 6:
+      if (span > 1) {
+
+        u32 other = start + ((off - start + 1) % span);
+        u8  tmp = out_buf[off];
+        out_buf[off] = out_buf[other];
+        out_buf[other] = tmp;
+
+      } else {
+
+        out_buf[off] ^= 0x55;
+
+      }
+      break;
+    case 7:
+      if (span > 1) {
+
+        u32 other = start + ((off - start + span - 1) % span);
+        out_buf[off] = out_buf[other];
+
+      } else {
+
+        out_buf[off] ^= 0xaa;
+
+      }
+      break;
+    case 8:
+      formtrig_fill_block(out_buf, len, off, span, block_len, 0x00);
+      break;
+    case 9:
+      formtrig_fill_block(out_buf, len, off, span, block_len, 0xff);
+      break;
+    case 10:
+      formtrig_fill_block(out_buf, len, off, span, block_len, 0x41);
+      break;
+    case 11:
+      formtrig_fill_block(out_buf, len, off, span, block_len, 0x7a);
+      break;
+    case 12:
+      formtrig_local_delete_like(out_buf, len, off, span, block_len);
+      break;
+    case 13:
+      formtrig_local_insert_like(out_buf, len, off, span, block_len, 0x00);
+      break;
+    case 14:
+      if (off + 3 < len) {
+
+        formtrig_write32_le(out_buf + off, 0u);
+
+      } else {
+
+        out_buf[off] ^= 0x55;
+
+      }
+      break;
+    default:
+      if (off + 3 < len) {
+
+        formtrig_write32_le(out_buf + off, 0xffffffffu);
+
+      } else {
+
+        out_buf[off] ^= 0xaa;
+
+      }
+      break;
+
+  }
+
+}
+
+static u8 formtrig_apply_hint_mutation_at(u8 *out_buf, u32 len, u32 start,
+                                          u32 span, u32 off, u32 op,
+                                          u32 sample, u32 hint_kind,
+                                          u32 hint_value) {
+
+  if (!hint_kind || !len || off >= len) { return 0; }
+
+  u8  byte_value = (u8)(hint_value & 0xffu);
+  u32 block_len = 1u << ((sample + (op >> 2)) & 3u);
+  if (!span) { span = 1; }
+  if (block_len > span) { block_len = span; }
+  if (!block_len) { block_len = 1; }
+
+  switch (hint_kind) {
+
+    case FORMTRIG_MUTATION_HINT_SET_BYTE:
+      switch (op & 7u) {
+
+        case 0:
+          out_buf[off] = byte_value;
+          break;
+        case 1:
+          out_buf[off] = (u8)(byte_value + 1u);
+          break;
+        case 2:
+          out_buf[off] = (u8)(byte_value - 1u);
+          break;
+        case 3:
+          out_buf[off] ^= byte_value ? byte_value : 0xffu;
+          break;
+        case 4:
+          out_buf[off] = 0;
+          break;
+        case 5:
+          out_buf[off] = 0xff;
+          break;
+        case 6:
+          out_buf[off] ^= 0x80;
+          break;
+        default:
+          out_buf[off] ^= (u8)(1u << (sample & 7u));
+          break;
+
+      }
+      return 1;
+
+    case FORMTRIG_MUTATION_HINT_CLEAR:
+      if ((op & 1u) == 0) {
+
+        formtrig_fill_block(out_buf, len, off, span, block_len, 0);
+
+      } else {
+
+        formtrig_fill_block(out_buf, len, start, span, span, 0);
+
+      }
+      return 1;
+
+    case FORMTRIG_MUTATION_HINT_FILL:
+      formtrig_fill_block(out_buf, len, off, span, block_len, byte_value);
+      return 1;
+
+    case FORMTRIG_MUTATION_HINT_DELETE:
+      formtrig_local_delete_like(out_buf, len, (op & 1u) ? off : start, span,
+                                 (op & 2u) ? block_len : span);
+      return 1;
+
+    case FORMTRIG_MUTATION_HINT_INSERT_BYTE:
+      formtrig_local_insert_like(out_buf, len, off, span, block_len,
+                                 byte_value);
+      return 1;
+
+    case FORMTRIG_MUTATION_HINT_WRITE_U16_LE:
+      if (off + 1 < len) {
+
+        formtrig_write16_le(out_buf + off, (u16)(hint_value & 0xffffu));
+
+      } else {
+
+        out_buf[off] = byte_value;
+
+      }
+      return 1;
+
+    case FORMTRIG_MUTATION_HINT_WRITE_U32_LE:
+      if (off + 3 < len) {
+
+        formtrig_write32_le(out_buf + off, hint_value);
+
+      } else {
+
+        out_buf[off] = byte_value;
+
+      }
+      return 1;
+
+    case FORMTRIG_MUTATION_HINT_XOR_BYTE:
+      out_buf[off] ^= byte_value ? byte_value : (u8)(1u << (op & 7u));
+      return 1;
+
+    default:
+      return 0;
+
+  }
+
+}
+
+static u8 formtrig_typed_mutation_stage(afl_state_t *afl, const u8 *in_buf,
+                                        u8 *out_buf, u32 len) {
+
+  if (!afl->formtrig_enabled) { return 0; }
+
+  const formtrig_queue_meta_t *m = &afl->queue_cur->formtrig;
+  u32 queue_id = afl->queue_cur ? afl->queue_cur->id : 0;
+  const char *skip_reason = NULL;
+  if (!m->seen) {
+
+    skip_reason = "no_runtime_signal";
+
+  } else if (!m->stable) {
+
+    skip_reason = "not_replay_stable";
+
+  } else if (!m->reached) {
+
+    skip_reason = "not_reached";
+
+  } else if (m->triggered) {
+
+    skip_reason = "already_triggered";
+
+  } else if (!len) {
+
+    skip_reason = "zero_length_input";
+
+  }
+
+  if (skip_reason) {
+
+    ++afl->formtrig_typed_skips;
+    formtrig_log_progress(afl, "typed_skip", skip_reason, m, queue_id, len);
+    return 0;
+
+  }
+
+  u32 component_count = formtrig_typed_actionable_count(m);
+  u32 native_range_count = formtrig_typed_native_hot_range_count(m, len);
+  u32 range_count = native_range_count
+                        ? native_range_count
+                        : formtrig_typed_fallback_hot_range_count(m, len);
+  if (!component_count) {
+
+    ++afl->formtrig_typed_skips;
+    formtrig_log_progress(afl, "typed_skip", "no_actionable_component", m,
+                          queue_id, len);
+    return 0;
+
+  }
+
+  if (!range_count) {
+
+    ++afl->formtrig_typed_skips;
+    formtrig_log_progress(afl, "typed_skip", "no_valid_hot_range", m,
+                          queue_id, len);
+    return 0;
+
+  }
+
+  u32 sample_count = formtrig_typed_range_samples();
+  u32 typed_ops = formtrig_typed_ops();
+  u32 typed_op_start = formtrig_typed_op_start();
+  u32 typed_schedule = formtrig_typed_schedule();
+  u32 stage_max = component_count * range_count * typed_ops *
+                  sample_count;
+  u32 stage_limit = formtrig_typed_mutation_max();
+  if (stage_max > stage_limit) {
+
+    stage_max = stage_limit;
+
+  }
+
+  afl->stage_name = "formtrig typed";
+  afl->stage_short = "ftgtype";
+  afl->stage_max = stage_max;
+  afl->stage_val_type = STAGE_VAL_NONE;
+  formtrig_log_progress(
+      afl, "typed_stage_start",
+      native_range_count ? "planned" : "fallback_no_hot_range", m, queue_id,
+      stage_max);
+
+  u32         typed_retain_max = formtrig_typed_retain_max();
+  const char *typed_retain_dir =
+      typed_retain_max ? formtrig_typed_retain_dir() : NULL;
+  u32 typed_retain_mode = formtrig_typed_retain_mode();
+  u32 typed_retained = 0;
+  u64 orig_hit_cnt = afl->queued_items + afl->saved_crashes;
+
+  for (afl->stage_cur = 0; afl->stage_cur < afl->stage_max;
+       ++afl->stage_cur) {
+
+    u32 cursor = afl->stage_cur;
+    u32 op = 0, component_index = 0, range_index = 0, sample_index = 0;
+    if (typed_schedule == FORMTRIG_TYPED_SCHEDULE_SAMPLE_FIRST) {
+
+      sample_index = cursor % sample_count;
+      cursor /= sample_count;
+      op = cursor % typed_ops;
+      cursor /= typed_ops;
+
+    } else {
+
+      op = cursor % typed_ops;
+      cursor /= typed_ops;
+      component_index = cursor % component_count;
+      cursor /= component_count;
+      range_index = cursor % range_count;
+      cursor /= range_count;
+      sample_index = cursor % sample_count;
+      cursor /= sample_count;
+
+    }
+    op = (op + typed_op_start) % typed_ops;
+    if (typed_schedule == FORMTRIG_TYPED_SCHEDULE_SAMPLE_FIRST) {
+
+      component_index = cursor % component_count;
+      cursor /= component_count;
+      range_index = cursor % range_count;
+
+    }
+
+    const formtrig_progress_component_t *component =
+        formtrig_typed_component(m, component_index);
+    u32 start = 0, span = 0, hint_kind = 0, hint_value = 0;
+    if (!component || !formtrig_typed_hot_range(m, len, range_index, &start,
+                                                &span, &hint_kind,
+                                                &hint_value)) {
+
+      continue;
+
+    }
+
+    u32 off =
+        formtrig_typed_sample_offset(start, span, sample_index, sample_count);
+    if (off >= len) { continue; }
+
+    memcpy(out_buf, in_buf, len);
+    afl->stage_cur_byte = off;
+    afl->stage_cur_val = (s32)component->kind;
+
+    if (formtrig_apply_hint_mutation_at(out_buf, len, start, span, off, op,
+                                        sample_index, hint_kind,
+                                        hint_value)) {
+
+      /* BindingSpec mutation hint applied. */
+
+    } else if (formtrig_fuzz_one_lower(component)) {
+
+      formtrig_apply_distance_mutation_at(out_buf, len, off, op);
+
+    } else {
+
+      formtrig_apply_state_mutation_at(out_buf, len, start, span, off, op,
+                                       sample_index);
+
+    }
+
+    if (!memcmp(out_buf, in_buf, len)) { continue; }
+
+    u32 hook_len = 0;
+    u8 *hook_buf = formtrig_run_typed_mutation_hook(
+        afl, in_buf, out_buf, len, start, span, off, op, sample_index,
+        hint_kind, hint_value, component, &hook_len);
+    u8 *exec_buf = hook_buf ? hook_buf : out_buf;
+    u32 exec_len = hook_buf ? hook_len : len;
+    if (!exec_len) {
+
+      if (hook_buf) { ck_free(hook_buf); }
+      continue;
+
+    }
+    if (exec_len == len && !memcmp(exec_buf, in_buf, len)) {
+
+      if (hook_buf) { ck_free(hook_buf); }
+      continue;
+
+    }
+
+#ifdef INTROSPECTION
+    snprintf(afl->mutation, sizeof(afl->mutation),
+             "%s FORMTRIG_TYPED kind=%u atom=%u role=%u off=%u",
+             afl->queue_cur->fname, component->kind, component->atom_id,
+             component->role, afl->stage_cur_byte);
+#endif
+
+    u8  hook_used = hook_buf ? 1 : 0;
+    u64 before_hit_cnt = afl->queued_items + afl->saved_crashes;
+    ++afl->formtrig_typed_execs;
+    u8 stop = common_fuzz_stuff(afl, exec_buf, exec_len);
+    u64 after_hit_cnt = afl->queued_items + afl->saved_crashes;
+    u8 retain_queued_candidate =
+        typed_retain_mode != FORMTRIG_TYPED_RETAIN_MODE_SIGNAL;
+    if (!stop && typed_retain_dir && typed_retained < typed_retain_max &&
+        (retain_queued_candidate || after_hit_cnt == before_hit_cnt) &&
+        formtrig_typed_retain_candidate(
+            afl, typed_retain_dir, exec_buf, exec_len, component, queue_id,
+            afl->stage_cur, op, component_index, range_index, sample_index,
+            start, span, off, typed_retained, hook_used, typed_retain_mode)) {
+
+      ++typed_retained;
+      formtrig_log_progress(afl, "typed_retain", "candidate_not_queued",
+                            &afl->formtrig_last, queue_id, typed_retained);
+
+    }
+    if (stop) {
+
+      if (hook_buf) { ck_free(hook_buf); }
+      return 1;
+
+    }
+    if (hook_buf) { ck_free(hook_buf); }
+
+  }
+
+  u64 new_hit_cnt = afl->queued_items + afl->saved_crashes;
+  afl->formtrig_typed_finds += new_hit_cnt - orig_hit_cnt;
+  formtrig_log_progress(afl, "typed_stage_end", "completed", m, queue_id,
+                        new_hit_cnt - orig_hit_cnt);
+#ifdef INTROSPECTION
+  afl->queue_cur->stats_mutated += stage_max;
+#endif
+
+  memcpy(out_buf, in_buf, len);
+  return 0;
+
+}
