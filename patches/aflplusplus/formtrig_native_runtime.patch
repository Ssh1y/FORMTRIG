+  ++afl->formtrig_stability_checks;
+
+  void *confirm_mem = mem;
+  u32   confirm_len = write_to_testcase(afl, &confirm_mem, len, 0);
+  if (unlikely(!confirm_len)) {
+
+    ++afl->formtrig_stability_failures;
+    formtrig_log_progress(afl, "stability_reject",
