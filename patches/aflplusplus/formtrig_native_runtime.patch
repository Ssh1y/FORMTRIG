+    if (!c->atom_id) { return 0; }
+    if (c->flags & FORMTRIG_COMPONENT_SPEC_LIFTED) {
+      /* FORMTRIG-main: BindingSpec-generated TC-root progress. */
+    } else if (c->flags & FORMTRIG_COMPONENT_HEURISTIC_LIFTED) {
+      if (!formtrig_allow_heuristic_lift()) { return 0; }
+    } else if (c->flags & FORMTRIG_COMPONENT_MANUAL_TARGET) {
+      if (!formtrig_allow_manual_lift()) { return 0; }
+    } else {
+      return 0;
+    }
+
+  }
+
+  u8 lower = formtrig_component_lower(c);
+  u8 higher = formtrig_component_higher(c);
+  if (lower == higher) { return 0; }
+
+  if (lower && c->value < 0.0) { return 0; }
+  if (higher && c->value <= 0.0) { return 0; }
+
+  /* A native binary distance of exactly 1 only says R=1,T=0. It is not
+     FORMTRIG progress and must not admit a non-trigger queue entry. */
+  if ((c->flags & FORMTRIG_COMPONENT_NATIVE) && lower &&
+      !formtrig_noncoarse_one(c->value)) {
+
+    return 0;
+
+  }
+
+  return 1;
+
+}
+
+static u8 formtrig_same_component_slot(
+    const formtrig_progress_component_t *a,
+    const formtrig_progress_component_t *b) {
+
+  return a && b && a->kind == b->kind && a->atom_id == b->atom_id &&
+         a->role == b->role && a->source_id == b->source_id &&
+         a->context_hash == b->context_hash;
+
+}
+
+static u32 formtrig_meta_component_count(const formtrig_queue_meta_t *m) {
+
+  if (!m) { return 0; }
+  return m->component_count > FORMTRIG_MAX_PROGRESS_COMPONENTS
+             ? FORMTRIG_MAX_PROGRESS_COMPONENTS
+             : m->component_count;
+
+}
+
+static u32 formtrig_meta_atom_signal_count(const formtrig_queue_meta_t *m) {
+
+  if (!m) { return 0; }
+  return m->atom_signal_count > FORMTRIG_MAX_ATOM_SIGNALS
+             ? FORMTRIG_MAX_ATOM_SIGNALS
+             : m->atom_signal_count;
+
+}
+
+static const formtrig_progress_component_t *formtrig_find_component(
+    const formtrig_queue_meta_t *m,
+    const formtrig_progress_component_t *slot) {
+
+  u32 count = formtrig_meta_component_count(m);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *component = &m->components[i];
+    if (formtrig_same_component_slot(component, slot)) { return component; }
+
+  }
+
+  return NULL;
+
+}
+
+static int formtrig_compare_component(
+    const formtrig_progress_component_t *candidate,
+    const formtrig_progress_component_t *frontier) {
+
+  if (!candidate || !frontier) { return 0; }
+  double eps = 1.0e-9;
+  if (formtrig_component_lower(candidate)) {
+
+    if (candidate->value + eps < frontier->value) { return 1; }
+    if (candidate->value > frontier->value + eps) { return -1; }
+    return 0;
+
+  }
+
+  if (formtrig_component_higher(candidate)) {
+
+    if (candidate->value > frontier->value + eps) { return 1; }
+    if (candidate->value + eps < frontier->value) { return -1; }
+    return 0;
+
+  }
+
+  return 0;
+
+}
+
+static u32 formtrig_actionable_component_count(const formtrig_queue_meta_t *m) {
+
+  u32 actionable = 0;
+  u32 count = formtrig_meta_component_count(m);
+  for (u32 i = 0; i < count; i++) {
+
+    if (formtrig_component_actionable(&m->components[i])) { ++actionable; }
+
+  }
+
+  return actionable;
+
+}
+
+static const formtrig_progress_component_t *formtrig_first_actionable_component(
+    const formtrig_queue_meta_t *m) {
+
+  u32 count = formtrig_meta_component_count(m);
+  for (u32 i = 0; i < count; i++) {
+
+    if (formtrig_component_actionable(&m->components[i])) {
+
+      return &m->components[i];
+
+    }
+
+  }
+
+  return NULL;
+
+}
+
+static u64 formtrig_env_u64(const char *name, u64 fallback) {
+
+  const char *env = getenv(name);
+  if (!env || !env[0]) { return fallback; }
+
+  char *end = NULL;
+  u64   limit = strtoull(env, &end, 10);
+  if (end == env) { return fallback; }
+  return limit;
+
+}
+
+static u64 formtrig_log_limit(void) {
+
+  return formtrig_env_u64("FORMTRIG_PROGRESS_LOG_LIMIT", 4096);
+
+}
+
+static u64 formtrig_saved_progress_log_limit(void) {
+
+  return formtrig_env_u64("FORMTRIG_SAVED_PROGRESS_LOG_LIMIT", 8192);
+
+}
+
+static u64 formtrig_saved_progress_log_sample_rate(void) {
+
+  return formtrig_env_u64("FORMTRIG_SAVED_PROGRESS_LOG_SAMPLE_RATE", 1024);
+
+}
+
+static u8 formtrig_log_event_is_critical(const char *event) {
+
+  if (!event) { return 0; }
+  return !strcmp(event, "calibrated_frontier") ||
+         !strcmp(event, "stability_confirmed") ||
+         !strcmp(event, "stability_reject") ||
+         !strcmp(event, "typed_skip") ||
+         !strcmp(event, "typed_stage_start") ||
+         !strcmp(event, "typed_stage_end");
+
+}
+
+static u8 formtrig_saved_progress_log_allowed(
+    afl_state_t *afl, const formtrig_queue_meta_t *m) {
+
+  ++afl->formtrig_saved_progress_log_seen;
+
+  u64 *class_seen = NULL;
+  if (m && m->triggered)
+    class_seen = &afl->formtrig_saved_triggered_log_seen;
+  else
+    class_seen = &afl->formtrig_saved_non_trigger_log_seen;
+
+  ++*class_seen;
+  u64 ordinal = *class_seen;
+  u64 limit = formtrig_saved_progress_log_limit();
+  if (!limit || ordinal <= limit) { return 1; }
+
+  u64 sample_rate = formtrig_saved_progress_log_sample_rate();
+  if (sample_rate && ordinal % sample_rate == 0) { return 1; }
+
+  ++afl->formtrig_progress_log_dropped;
+  return 0;
+
+}
+
+static u8 formtrig_log_allowed(afl_state_t *afl, const char *event,
+                               const formtrig_queue_meta_t *m) {
+
+  if (!afl || !afl->formtrig_enabled || !afl->out_dir) { return 0; }
+  if (formtrig_env_disabled(getenv("FORMTRIG_PROGRESS_LOG"))) { return 0; }
+
+  u8 saved_progress = event && !strcmp(event, "saved_progress");
+  if (saved_progress && !formtrig_saved_progress_log_allowed(afl, m)) {
+
+    return 0;
+
+  }
+
+  if (saved_progress) {
+
+    ++afl->formtrig_progress_log_events;
+    return 1;
+
+  }
+
+  u64 limit = formtrig_log_limit();
+  if (!formtrig_log_event_is_critical(event) && limit &&
+      afl->formtrig_progress_log_events >= limit) {
+
+    ++afl->formtrig_progress_log_dropped;
+    return 0;
+
+  }
+
+  ++afl->formtrig_progress_log_events;
+  return 1;
+
+}
+
+static void formtrig_json_double(FILE *f, double v) {
+
+  if (formtrig_finite(v)) {
+
+    fprintf(f, "%.17g", v);
+
+  } else {
+
+    fputs("null", f);
+
+  }
+
+}
+
+void formtrig_log_progress(afl_state_t *afl, const char *event,
+                           const char *reason,
+                           const formtrig_queue_meta_t *m, u32 queue_id,
+                           u64 aux) {
+
+  if (!formtrig_log_allowed(afl, event, m)) { return; }
+
+  u8 *path = alloc_printf("%s/formtrig_progress.jsonl", afl->out_dir);
+  FILE *f = fopen((char *)path, "a");
+  if (!f) {
+
+    ck_free(path);
+    return;
+
+  }
+
+  u32 component_count = formtrig_meta_component_count(m);
+  u32 atom_signal_count = formtrig_meta_atom_signal_count(m);
+  u32 actionable = formtrig_actionable_component_count(m);
+  const formtrig_progress_component_t *first =
+      formtrig_first_actionable_component(m);
+  u8 have_signal = m && m->seen;
+
+  fprintf(f,
+          "{\"event\":\"%s\",\"reason\":\"%s\",\"execs_done\":%llu,"
+          "\"queue_id\":%u,\"queued_items\":%u,\"frontier_count\":%u,"
+          "\"frontier_updates\":%llu,\"seen\":%u,\"reached\":%u,"
+          "\"triggered\":%u,\"lifted\":%u,\"stable\":%u,"
+          "\"d_t\":",
+          event ? event : "unknown", reason ? reason : "unknown",
+          (unsigned long long)afl->fsrv.total_execs, queue_id,
+          afl->queued_items, afl->formtrig_frontier_count,
+          (unsigned long long)afl->formtrig_frontier_updates,
+          m ? m->seen : 0, m ? m->reached : 0, m ? m->triggered : 0,
+          m ? m->lifted : 0, m ? m->stable : 0);
+  formtrig_json_double(f, have_signal ? m->d_t : FORMTRIG_INF);
+  fputs(",\"d_f\":", f);
+  formtrig_json_double(f, have_signal ? m->d_f : FORMTRIG_INF);
+  fputs(",\"d_f_lifted\":", f);
+  formtrig_json_double(f, have_signal ? m->d_f_lifted : FORMTRIG_INF);
+  fputs(",\"d_f_spec_lifted\":", f);
+  formtrig_json_double(f, have_signal ? m->d_f_spec_lifted : FORMTRIG_INF);
+  fputs(",\"d_f_heuristic_lifted\":", f);
+  formtrig_json_double(f, have_signal ? m->d_f_heuristic_lifted : FORMTRIG_INF);
+  fputs(",\"d_f_manual_lifted\":", f);
+  formtrig_json_double(f, have_signal ? m->d_f_manual_lifted : FORMTRIG_INF);
+  fprintf(f,
+          ",\"components\":%u,\"atom_signals\":%u,"
+          "\"actionable_components\":%u,"
+          "\"hot_ranges\":%u,\"target_hit_count\":%u,"
+          "\"source_flags\":%u,\"observed_source_flags\":%u,"
+          "\"trace_signature\":\"%016llx\",\"aux\":%llu",
+          component_count, atom_signal_count, actionable,
+          m ? m->hot_range_count : 0,
+          m ? m->target_hit_count : 0,
+          m ? m->source_flags : 0,
+          m ? m->observed_source_flags : 0,
+          (unsigned long long)(m ? m->trace_signature : 0),
+          (unsigned long long)aux);
+
+  if (first) {
+
+    fprintf(f,
+            ",\"first_actionable\":{\"kind\":%u,\"atom_id\":%u,"
+            "\"role\":%u,\"priority\":%u,\"flags\":%u,\"source_id\":%llu,"
+            "\"context_hash\":\"%016llx\",\"value\":",
+            first->kind, first->atom_id, first->role, first->priority,
+            first->flags, (unsigned long long)first->source_id,
+            (unsigned long long)first->context_hash);
+    formtrig_json_double(f, first->value);
+    fputs(",\"confidence\":", f);
+    formtrig_json_double(f, first->confidence);
+    fputs("}", f);
+
+  }
+
+  fputs(",\"component_values\":[", f);
+  for (u32 i = 0; m && i < component_count; i++) {
+
+    const formtrig_progress_component_t *component = &m->components[i];
+    if (i) { fputc(',', f); }
+    fprintf(f,
+            "{\"kind\":%u,\"atom_id\":%u,\"role\":%u,"
+            "\"priority\":%u,\"flags\":%u,"
+            "\"source_id\":%llu,\"context_hash\":\"%016llx\",\"value\":",
+            component->kind, component->atom_id, component->role,
+            component->priority, component->flags,
+            (unsigned long long)component->source_id,
+            (unsigned long long)component->context_hash);
+    formtrig_json_double(f, component->value);
+    fputs(",\"confidence\":", f);
+    formtrig_json_double(f, component->confidence);
+    fputc('}', f);
+
+  }
+  fputc(']', f);
+
+  fputs(",\"atom_signal_values\":[", f);
+  for (u32 i = 0; m && i < atom_signal_count; i++) {
+
+    const formtrig_atom_signal_t *signal = &m->atom_signals[i];
+    if (i) { fputc(',', f); }
+    fprintf(f,
+            "{\"atom_id\":%u,\"role_bits\":%u,\"event_bits\":%u,"
+            "\"lifecycle_prefix\":%u,\"root_value_bucket\":%u,"
+            "\"object_id_bucket\":%u,\"guard_bits\":%u,"
+            "\"producer_bits\":%u,\"use_bits\":%u,\"flags\":%u}",
+            signal->atom_id, signal->role_bits, signal->event_bits,
+            signal->lifecycle_prefix, signal->root_value_bucket,
+            signal->object_id_bucket, signal->guard_bits,
+            signal->producer_bits, signal->use_bits, signal->flags);
+
+  }
+  fputc(']', f);
+
+  fputs("}\n", f);
+  fclose(f);
+  ck_free(path);
+
+}
+
+static u8 formtrig_vector_has_same_atom(
+    const formtrig_queue_meta_t *m,
+    const formtrig_progress_component_t *slot) {
+
+  if (!m || !slot || !slot->atom_id) { return 0; }
+  u32 count = formtrig_meta_component_count(m);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *component = &m->components[i];
+    if (formtrig_component_actionable(component) &&
+        component->atom_id == slot->atom_id) {
+
+      return 1;
+
+    }
+
+  }
+
+  return 0;
+
+}
+
+static u8 formtrig_component_is_lifted_state(
+    const formtrig_progress_component_t *component) {
+
+  if (!formtrig_component_actionable(component)) { return 0; }
+  if (!(component->flags & FORMTRIG_COMPONENT_LIFTED)) { return 0; }
+  if (!(component->flags & FORMTRIG_COMPONENT_SPEC_LIFTED)) { return 0; }
+
+  switch (component->role) {
+
+    case FORMTRIG_ROLE_ROOT_OBSERVE:
+    case FORMTRIG_ROLE_GUARD:
+    case FORMTRIG_ROLE_PRODUCER:
+    case FORMTRIG_ROLE_DESIRED_PRODUCER:
+    case FORMTRIG_ROLE_OPPOSITE_PRODUCER:
+    case FORMTRIG_ROLE_USE:
+    case FORMTRIG_ROLE_LIFECYCLE_EVENT:
+    case FORMTRIG_ROLE_SAME_OBJECT:
+      return 1;
+    default:
+      return 0;
+
+  }
+
+}
+
+static u8 formtrig_lifted_state_differs(
+    const formtrig_queue_meta_t *candidate,
+    const formtrig_queue_meta_t *older) {
+
+  u32 count = formtrig_meta_component_count(candidate);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *candidate_component =
+        &candidate->components[i];
+    if (!formtrig_component_is_lifted_state(candidate_component)) { continue; }
+
+    const formtrig_progress_component_t *older_component =
+        formtrig_find_component(older, candidate_component);
+    if (!older_component ||
+        !formtrig_component_is_lifted_state(older_component)) {
+
+      return 1;
+
+    }
+
+    if (fabs(candidate_component->value - older_component->value) > 1.0e-9) {
+
+      return 1;
+
+    }
+
+  }
+
+  return 0;
+
+}
+
+static const formtrig_atom_signal_t *formtrig_find_atom_signal(
+    const formtrig_queue_meta_t *m, u32 atom_id) {
+
+  if (!m || !atom_id) { return NULL; }
+  u32 count = formtrig_meta_atom_signal_count(m);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_atom_signal_t *signal = &m->atom_signals[i];
+    if (signal->atom_id == atom_id) { return signal; }
+
+  }
+
+  return NULL;
+
+}
+
+static u8 formtrig_atom_signal_state_differs(
+    const formtrig_queue_meta_t *candidate,
+    const formtrig_queue_meta_t *older) {
+
+  u32 count = formtrig_meta_atom_signal_count(candidate);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_atom_signal_t *candidate_signal = &candidate->atom_signals[i];
+    if (!candidate_signal->atom_id ||
+        !(candidate_signal->flags & FORMTRIG_ATOM_SIGNAL_OBSERVED)) {
+
+      continue;
+
+    }
+
+    const formtrig_atom_signal_t *older_signal =
+        formtrig_find_atom_signal(older, candidate_signal->atom_id);
+    if (!older_signal ||
+        !(older_signal->flags & FORMTRIG_ATOM_SIGNAL_OBSERVED)) {
+
+      return 1;
+
+    }
+
+    if (candidate_signal->role_bits != older_signal->role_bits ||
+        candidate_signal->lifecycle_prefix != older_signal->lifecycle_prefix ||
+        candidate_signal->root_value_bucket != older_signal->root_value_bucket ||
+        candidate_signal->object_id_bucket != older_signal->object_id_bucket ||
+        candidate_signal->guard_bits != older_signal->guard_bits ||
+        candidate_signal->producer_bits != older_signal->producer_bits ||
+        candidate_signal->use_bits != older_signal->use_bits) {
+
+      return 1;
+
+    }
+
+  }
+
+  return 0;
+
+}
+
+static u8 formtrig_equal_or_better_df(const formtrig_queue_meta_t *candidate,
+                                      const formtrig_queue_meta_t *older) {
+
+  double candidate_df = formtrig_meta_df(candidate);
+  double older_df = formtrig_meta_df(older);
+  if (!formtrig_finite(candidate_df) || !formtrig_finite(older_df)) {
+
+    return 0;
+
+  }
+
+  return candidate_df <= older_df + 1.0e-9;
+
+}
+
+static u8 formtrig_within_semantic_df_slack(
+    const formtrig_queue_meta_t *candidate,
+    const formtrig_queue_meta_t *older) {
+
+  double candidate_df = formtrig_meta_df(candidate);
+  double older_df = formtrig_meta_df(older);
+  if (!formtrig_finite(candidate_df) || !formtrig_finite(older_df)) {
+
+    return 0;
+
+  }
+
+  double slack = (double)formtrig_env_u64("FORMTRIG_SEMANTIC_DF_SLACK", 2);
+  if (slack < 0.0) { slack = 0.0; }
+  return candidate_df <= older_df + slack + 1.0e-9;
+
+}
+
+static u8 formtrig_semantic_alternative_state(
+    const formtrig_queue_meta_t *candidate,
+    const formtrig_queue_meta_t *older) {
+
+  if (!candidate || !older || !candidate->lifted) { return 0; }
+  if (!(candidate->observed_source_flags & FORMTRIG_SOURCE_SPEC_LIFTED) &&
+      !(candidate->source_flags & FORMTRIG_SOURCE_SPEC_LIFTED)) {
+
+    return 0;
+
+  }
+
+  if (formtrig_equal_or_better_df(candidate, older)) {
+
+    return formtrig_lifted_state_differs(candidate, older) ||
+           formtrig_atom_signal_state_differs(candidate, older);
+
+  }
+
+  if (!formtrig_within_semantic_df_slack(candidate, older)) { return 0; }
+  return formtrig_atom_signal_state_differs(candidate, older);
+
+}
+
+static u8 formtrig_vector_covers(const formtrig_queue_meta_t *older,
+                                 const formtrig_queue_meta_t *candidate) {
+
+  u8  saw_candidate_component = 0;
+  u32 count = formtrig_meta_component_count(candidate);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *candidate_component =
+        &candidate->components[i];
+    if (!formtrig_component_actionable(candidate_component)) { continue; }
+    saw_candidate_component = 1;
+
+    const formtrig_progress_component_t *older_component =
+        formtrig_find_component(older, candidate_component);
+    if (!older_component || !formtrig_component_actionable(older_component)) {
+
+      return 0;
+
+    }
+
+    if (formtrig_compare_component(candidate_component, older_component) > 0) {
+
+      return 0;
+
+    }
+
+  }
+
+  if (saw_candidate_component &&
+      formtrig_semantic_alternative_state(candidate, older)) {
+
+    return 0;
+
+  }
+
+  return saw_candidate_component;
+
+}
+
+static u8 formtrig_vector_dominates(const formtrig_queue_meta_t *candidate,
+                                    const formtrig_queue_meta_t *older) {
+
+  if (!formtrig_vector_covers(candidate, older)) { return 0; }
+
+  u32 count = formtrig_meta_component_count(candidate);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *candidate_component =
+        &candidate->components[i];
+    if (!formtrig_component_actionable(candidate_component)) { continue; }
+
+    const formtrig_progress_component_t *older_component =
+        formtrig_find_component(older, candidate_component);
+    if (!older_component) { return 1; }
+    if (formtrig_compare_component(candidate_component, older_component) > 0) {
+
+      return 1;
+
+    }
+
+  }
+
+  return 0;
+
+}
+
+static u8 formtrig_shared_high_priority_regression(
+    const formtrig_queue_meta_t *candidate,
+    const formtrig_queue_meta_t *older) {
+
+  u32 best_improved_priority = UINT_MAX;
+  u32 count = formtrig_meta_component_count(candidate);
+
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *candidate_component =
+        &candidate->components[i];
+    if (!formtrig_component_actionable(candidate_component)) { continue; }
+
+    const formtrig_progress_component_t *older_component =
+        formtrig_find_component(older, candidate_component);
+    if (!older_component ||
+        formtrig_compare_component(candidate_component, older_component) > 0) {
+
+      if (candidate_component->priority < best_improved_priority)
+        best_improved_priority = candidate_component->priority;
+
+    }
+
+  }
+
+  if (best_improved_priority == UINT_MAX) { return 0; }
+
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *candidate_component =
+        &candidate->components[i];
+    if (!formtrig_component_actionable(candidate_component)) { continue; }
+    if (candidate_component->priority >= best_improved_priority) { continue; }
+
+    const formtrig_progress_component_t *older_component =
+        formtrig_find_component(older, candidate_component);
+    if (older_component &&
+        formtrig_compare_component(candidate_component, older_component) < 0) {
+
+      return 1;
+
+    }
+
+  }
+
+  count = formtrig_meta_component_count(older);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *older_component =
+        &older->components[i];
+    if (!formtrig_component_actionable(older_component)) { continue; }
+    if (older_component->priority >= best_improved_priority) { continue; }
+    if (!formtrig_vector_has_same_atom(candidate, older_component)) { continue; }
+    if (!formtrig_find_component(candidate, older_component)) { return 1; }
+
+  }
+
+  return 0;
+
+}
+
+static const char *formtrig_semantic_accept_reason(
+    const formtrig_queue_meta_t *m) {
+
+  if (!m) { return "lifted_feature_improvement"; }
+  if (m->triggered) { return "triggered"; }
+
+  u32 count = formtrig_meta_component_count(m);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *component = &m->components[i];
+    if (!formtrig_component_actionable(component)) { continue; }
+
+    if ((component->flags & FORMTRIG_COMPONENT_NATIVE) &&
+        component->kind == FORMTRIG_COMPONENT_NATIVE_DISTANCE) {
+
+      return "native_distance_improvement";
+
+    }
+
+    if (component->role == FORMTRIG_ROLE_LIFECYCLE_EVENT) {
+
+      return "lifecycle_prefix_improvement";
+
+    }
+
+    if (component->role == FORMTRIG_ROLE_INPUT_INFLUENCE ||
+        component->kind == FORMTRIG_COMPONENT_OPERAND_INFLUENCE) {
+
+      return "influence_confidence_improvement";
+
+    }
+
+    if (component->role == FORMTRIG_ROLE_ROOT_OBSERVE ||
+        component->role == FORMTRIG_ROLE_GUARD ||
+        component->role == FORMTRIG_ROLE_PRODUCER ||
+        component->role == FORMTRIG_ROLE_DESIRED_PRODUCER ||
+        component->role == FORMTRIG_ROLE_OPPOSITE_PRODUCER ||
+        component->role == FORMTRIG_ROLE_USE ||
+        component->role == FORMTRIG_ROLE_SAME_OBJECT) {
+
+      return "root_aligned_state_transition";
+
+    }
+
+  }
+
+  return "lifted_feature_improvement";
+
+}
+
+static u8 formtrig_pre_reach_guidance_eligible(
+    const formtrig_queue_meta_t *m) {
+
+  if (!m || !m->seen || m->reached || m->triggered) { return 0; }
+  if (!(m->source_flags & FORMTRIG_SOURCE_SPEC_LIFTED)) { return 0; }
+  return formtrig_actionable_component_count(m) ? 1 : 0;
+
+}
+
+static u8 formtrig_guidance_eligible(const formtrig_queue_meta_t *m) {
+
+  if (!m || !m->seen) { return 0; }
+  return m->reached || formtrig_pre_reach_guidance_eligible(m);
+
+}
+
+static const char *formtrig_reach_or_pre_reach_reason(
+    const formtrig_queue_meta_t *m) {
+
+  return formtrig_pre_reach_guidance_eligible(m) ? "pre_reach_guidance"
+                                                 : "not_reached";
+
+}
+
+static const char *formtrig_frontier_reason(afl_state_t *afl,
+                                            const formtrig_queue_meta_t *m,
+                                            u8 *accepted) {
+
+  if (accepted) { *accepted = 0; }
+
+  if (!afl || !afl->formtrig_enabled) { return "formtrig_disabled"; }
+  if (!m || !m->seen) { return "no_runtime_signal"; }
+  if (!formtrig_guidance_eligible(m)) {
+
+    return formtrig_reach_or_pre_reach_reason(m);
+
+  }
+  if (m->triggered) {
+
+    if (accepted) { *accepted = 1; }
+    return "triggered";
+
+  }
+
+  if (!formtrig_actionable_component_count(m)) {
+
+    return "no_actionable_component";
+
+  }
+
+  u8 dominates_existing = 0;
+  for (u32 i = 0; i < afl->formtrig_frontier_count; i++) {
+
+    const formtrig_queue_meta_t *older = &afl->formtrig_frontier[i].vector;
+
+    if (formtrig_vector_covers(older, m)) {
+
+      return "dominated_by_existing_frontier";
+
+    }
+
+    if (formtrig_shared_high_priority_regression(m, older)) {
+
+      return "high_priority_regression";
+
+    }
+
+    if (formtrig_vector_dominates(m, older)) { dominates_existing = 1; }
+
+  }
+
+  if (afl->formtrig_frontier_count >= FORMTRIG_FRONTIER_MAX &&
+      !dominates_existing) {
+
+    return "frontier_full";
+
+  }
+
+  if (accepted) { *accepted = 1; }
+  if (!afl->formtrig_frontier_count) { return "frontier_empty_seed"; }
+  (void)dominates_existing;
+  return formtrig_semantic_accept_reason(m);
+
+}
+
+void formtrig_capture_last(afl_state_t *afl) {
+
+  memset(&afl->formtrig_last, 0, sizeof(afl->formtrig_last));
+  if (!afl->formtrig_enabled || !afl->formtrig_shm_area) { return; }
+
+  const formtrig_shm_record_t *rec =
+      (const formtrig_shm_record_t *)(const void *)afl->formtrig_shm_area;
+  if (rec->magic != FORMTRIG_SHM_MAGIC ||
+      rec->version != FORMTRIG_SHM_VERSION) {
+
+    return;
+
+  }
+
+  formtrig_queue_meta_t meta;
+  memset(&meta, 0, sizeof(meta));
+  meta.seen = 1;
+  meta.reached = (rec->flags & FORMTRIG_FLAG_REACHED) ? 1 : 0;
+  meta.triggered = (rec->flags & FORMTRIG_FLAG_CRASH_PREDICATE) ? 1 : 0;
+  meta.lifted = (rec->flags & FORMTRIG_FLAG_LIFTED) ? 1 : 0;
+  meta.target_hit_count = rec->target_hit_count;
+  meta.hot_range_count = rec->hot_range_count;
+  meta.trace_signature = rec->trace_signature;
+  meta.d_t = rec->d_t;
+  meta.d_f = rec->d_f;
+  meta.d_f_lifted = rec->d_f_lifted;
+  meta.d_f_spec_lifted = rec->d_f_spec_lifted;
+  meta.d_f_heuristic_lifted = rec->d_f_heuristic_lifted;
+  meta.d_f_manual_lifted = rec->d_f_manual_lifted;
+  meta.source_flags = rec->source_flags;
+  meta.observed_source_flags = rec->observed_source_flags;
+  if (meta.hot_range_count > FORMTRIG_MAX_HOT_RANGES)
+    meta.hot_range_count = FORMTRIG_MAX_HOT_RANGES;
+  memcpy(meta.hot_ranges, rec->hot_ranges,
+         sizeof(formtrig_hot_range_t) * meta.hot_range_count);
+  meta.component_count = rec->component_count;
+  if (meta.component_count > FORMTRIG_MAX_PROGRESS_COMPONENTS)
+    meta.component_count = FORMTRIG_MAX_PROGRESS_COMPONENTS;
+  memcpy(meta.components, rec->components,
+         sizeof(formtrig_progress_component_t) * meta.component_count);
+  meta.atom_signal_count = rec->atom_signal_count;
+  if (meta.atom_signal_count > FORMTRIG_MAX_ATOM_SIGNALS)
+    meta.atom_signal_count = FORMTRIG_MAX_ATOM_SIGNALS;
+  memcpy(meta.atom_signals, rec->atom_signals,
+         sizeof(formtrig_atom_signal_t) * meta.atom_signal_count);
+  afl->formtrig_last = meta;
+
+  ++afl->formtrig_seen_execs;
+  if (meta.reached) { ++afl->formtrig_reached_execs; }
+  if (meta.triggered) { ++afl->formtrig_triggered_execs; }
+
+}
+
+void formtrig_apply_last_to_queue(afl_state_t *afl, struct queue_entry *q) {
+
+  if (!q || !afl->formtrig_last.seen) { return; }
+  q->formtrig = afl->formtrig_last;
+
+}
+
+u8 formtrig_should_save(afl_state_t *afl) {
+
+  const formtrig_queue_meta_t *m = &afl->formtrig_last;
+  u8 accepted = 0;
+  const char *reason = formtrig_frontier_reason(afl, m, &accepted);
+  if (!accepted && formtrig_guidance_eligible(m)) {
+
+    formtrig_log_progress(afl, "frontier_reject", reason, m, 0, 0);
+
+  }
+
+  return accepted;
+
+}
+
+u8 formtrig_progress_stable(const formtrig_queue_meta_t *baseline,
+                            const formtrig_queue_meta_t *confirmed) {
+
+  if (!baseline || !confirmed) { return 0; }
+  if (!formtrig_guidance_eligible(baseline)) { return 0; }
+  if (!formtrig_guidance_eligible(confirmed)) { return 0; }
+
+  if (baseline->triggered || confirmed->triggered) {
+
+    return baseline->triggered && confirmed->triggered;
+
+  }
+
+  u8  saw_actionable = 0;
+  u32 count = formtrig_meta_component_count(baseline);
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *base_component =
+        &baseline->components[i];
+    if (!formtrig_component_actionable(base_component)) { continue; }
+    saw_actionable = 1;
+
+    const formtrig_progress_component_t *confirm_component =
+        formtrig_find_component(confirmed, base_component);
+    if (!confirm_component ||
+        !formtrig_component_actionable(confirm_component)) {
+
+      return 0;
+
+    }
+
+    if (formtrig_compare_component(confirm_component, base_component) < 0) {
+
+      return 0;
+
+    }
+
+  }
+
+  return saw_actionable;
+
+}
+
+static u8 formtrig_update_scalar_best(afl_state_t *afl) {
+
+  const formtrig_queue_meta_t *m = &afl->formtrig_last;
+  if (!afl->formtrig_enabled || !formtrig_guidance_eligible(m)) { return 0; }
+  if (m->triggered) { return 0; }
+
+  u8 changed = 0;
+
+  double df = formtrig_meta_df(m);
+  if ((m->lifted || formtrig_noncoarse_one(df)) &&
+      formtrig_finite(df) && df < afl->formtrig_best_df) {
+
+    afl->formtrig_best_df = df;
+    changed = 1;
+
+  }
+
+  if (formtrig_noncoarse_one(m->d_t) && m->d_t > 0.0 &&
+      m->d_t < afl->formtrig_best_dt) {
+
+    afl->formtrig_best_dt = m->d_t;
+    changed = 1;
+
+  }
+
+  return changed;
+
+}
+
+static u8 formtrig_update_frontier(afl_state_t *afl,
+                                   const formtrig_queue_meta_t *m,
+                                   u32 queue_id, const char *event) {
+
+  if (!afl->formtrig_enabled || !formtrig_guidance_eligible(m)) { return 0; }
+  if (m->triggered) { return 0; }
+  if (!m->stable) {
+
+    formtrig_log_progress(afl, "frontier_reject", "not_replay_stable", m,
+                          queue_id, 0);
+    return 0;
+
+  }
+  u8 accepted = 0;
+  const char *reason = formtrig_frontier_reason(afl, m, &accepted);
+  if (!accepted) {
+
+    formtrig_log_progress(afl, "frontier_reject", reason, m, queue_id, 0);
+    return 0;
+
+  }
+
+  if (!strcmp(reason, "frontier_empty_seed") && event &&
+      !strcmp(event, "calibrated_frontier")) {
+
+    reason = "initial_frontier_seed";
+
+  }
+
+  u8 changed = 0;
+  for (u32 i = 0; i < afl->formtrig_frontier_count;) {
+
+    if (formtrig_vector_dominates(m, &afl->formtrig_frontier[i].vector)) {
+
+      u32 tail = afl->formtrig_frontier_count - i - 1;
+      if (tail) {
+
+        memmove(&afl->formtrig_frontier[i], &afl->formtrig_frontier[i + 1],
+                sizeof(afl->formtrig_frontier[0]) * tail);
+
+      }
+      --afl->formtrig_frontier_count;
+      changed = 1;
+      continue;
+
+    }
+
+    ++i;
+
+  }
+
+  if (afl->formtrig_frontier_count >= FORMTRIG_FRONTIER_MAX) {
+
+    if (changed) {
+
+      formtrig_log_progress(afl, event ? event : "frontier_accept", reason, m,
+                            queue_id, changed);
+
+    }
+
+    return changed;
+
+  }
+
+  formtrig_frontier_entry_t *entry =
+      &afl->formtrig_frontier[afl->formtrig_frontier_count++];
+  memset(entry, 0, sizeof(*entry));
+  entry->vector = *m;
+  entry->queue_id = queue_id;
+  changed = 1;
+
+  if (changed) { ++afl->formtrig_frontier_updates; }
+  formtrig_log_progress(afl, event ? event : "frontier_accept", reason, m,
+                        queue_id, changed);
+  return changed;
+
+}
+
+void formtrig_note_saved(afl_state_t *afl) {
+
+  u32 queue_id = afl->queue_top ? afl->queue_top->id : 0;
+  u8  changed = formtrig_update_frontier(afl, &afl->formtrig_last, queue_id,
+                                         "saved_progress");
+  (void)formtrig_update_scalar_best(afl);
+
+  if (changed || afl->formtrig_last.triggered) {
+
+    ++afl->formtrig_queued_progress;
+    if (!changed && afl->formtrig_last.triggered) {
+
+      formtrig_log_progress(afl, "saved_progress", "triggered",
+                            &afl->formtrig_last, queue_id, 0);
+
+    }
+
+  }
+
+}
+
+void formtrig_note_calibrated(afl_state_t *afl) {
+
+  u32 queue_id = afl->queue_cur ? afl->queue_cur->id : 0;
+  (void)formtrig_update_frontier(afl, &afl->formtrig_last, queue_id,
