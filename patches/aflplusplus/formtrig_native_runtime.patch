+  if (afl->stop_soon) {
+
+    ++afl->formtrig_stability_failures;
+    formtrig_log_progress(afl, "stability_reject", "stop_requested", base, 0,
+                          len);
+    return 0;
+
+  }
+
+  if (confirm_fault != afl->crash_mode) {
+
+    ++afl->formtrig_stability_failures;
+    formtrig_log_progress(afl, "stability_reject", "fault_changed", base, 0,
+                          len);
+    return 0;
+
+  }
+
+  if (!formtrig_progress_stable(base, &afl->formtrig_last)) {
+
+    ++afl->formtrig_stability_failures;
+    formtrig_log_progress(afl, "stability_reject",
+                          "progress_not_replay_stable", base, 0, len);
+    return 0;
+
+  }
+
+  formtrig_log_progress(afl, "stability_confirmed", "progress_replay_stable",
+                        base, 0, len);
+  return 1;
+
+}
