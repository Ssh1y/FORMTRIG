+static u8 formtrig_write_all_fd(int fd, const void *buf, size_t len) {
+
+  const u8 *bytes = (const u8 *)buf;
+  size_t    written = 0;
+  while (written < len) {
+
+    ssize_t ret = write(fd, bytes + written, len - written);
+    if (ret < 0) {
+
+      if (errno == EINTR) { continue; }
+      return 0;
+
+    }
+    if (!ret) { return 0; }
+    written += (size_t)ret;
+
+  }
+
+  return 1;
+
+}
+
+static u8 formtrig_write_all_to_file(const char *path, const u8 *buf,
+                                     u32 len) {
+
+  int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+  if (fd < 0) { return 0; }
+
+  if (!formtrig_write_all_fd(fd, buf, len)) {
+
+    close(fd);
+    return 0;
+
+  }
+
+  if (close(fd)) { return 0; }
+  return 1;
+
+}
