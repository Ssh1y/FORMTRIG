+static u8 formtrig_env_enabled(void) {
+
+  const char *env = getenv("AFL_FORMTRIG");
+  if (!env || !env[0]) { env = getenv("FORMTRIG_AFLPP"); }
+  return env && (env[0] == '1' || env[0] == 'y' || env[0] == 'Y' ||
+                 env[0] == 't' || env[0] == 'T');
+
+}
+
+static u8 formtrig_finite(double v) {
+
+  return isfinite(v) && v > -FORMTRIG_INF / 2.0 && v < FORMTRIG_INF / 2.0;
+
+}
+
+static u8 formtrig_env_disabled(const char *env) {
+
+  return env && env[0] &&
+         (env[0] == '0' || env[0] == 'n' || env[0] == 'N' ||
+          env[0] == 'f' || env[0] == 'F');
+
+}
+
+static u8 formtrig_env_truthy(const char *env) {
+
+  return env && env[0] &&
+         (env[0] == '1' || env[0] == 'y' || env[0] == 'Y' ||
+          env[0] == 't' || env[0] == 'T');
+
+}
+
+static u8 formtrig_allow_heuristic_lift(void) {
+
+  return formtrig_env_truthy(getenv("FORMTRIG_ALLOW_HEURISTIC_LIFT"));
+
+}
+
+static u8 formtrig_allow_manual_lift(void) {
+
+  return formtrig_env_truthy(getenv("FORMTRIG_ALLOW_MANUAL_LIFT"));
+
+}
+
+static u8 formtrig_noncoarse_one(double v) {
+
+  return formtrig_finite(v) && fabs(v - 1.0) > 1.0e-9;
+
+}
+
+static void formtrig_clear_record(formtrig_shm_record_t *rec) {
+
+  memset(rec, 0, sizeof(*rec));
+
+}
+
+void formtrig_init(afl_state_t *afl) {
+
+  if (!formtrig_env_enabled()) { return; }
+
+  char path[64];
+  snprintf(path, sizeof(path), "/formtrig_%d_%ld", getpid(), random());
+
+  int fd = shm_open(path, O_CREAT | O_RDWR | O_EXCL, DEFAULT_PERMISSION);
+  if (unlikely(fd < 0)) { PFATAL("FORMTRIG shm_open() failed"); }
+
+  if (unlikely(ftruncate(fd, FORMTRIG_SHM_SIZE))) {
+
+    shm_unlink(path);
+    close(fd);
+    PFATAL("FORMTRIG ftruncate() failed");
+
+  }
+
+  void *area =
+      mmap(0, FORMTRIG_SHM_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (unlikely(area == MAP_FAILED || !area)) {
+
+    shm_unlink(path);
+    close(fd);
+    PFATAL("FORMTRIG mmap() failed");
+
+  }
+
+  afl->formtrig_enabled = 1;
+  afl->formtrig_shm_fd = fd;
+  afl->formtrig_shm_area = (u8 *)area;
+  afl->formtrig_shm_path = ck_strdup((u8 *)path);
+  formtrig_clear_record((formtrig_shm_record_t *)area);
+  setenv(FORMTRIG_SHM_ENV_VAR, path, 1);
+  OKF("FORMTRIG native signal channel enabled");
+
+}
+
+void formtrig_deinit(afl_state_t *afl) {
+
+  if (afl->formtrig_shm_area) {
+
+    munmap(afl->formtrig_shm_area, FORMTRIG_SHM_SIZE);
+    afl->formtrig_shm_area = NULL;
+
+  }
+
+  if (afl->formtrig_shm_fd >= 0) {
+
+    close(afl->formtrig_shm_fd);
+    afl->formtrig_shm_fd = -1;
+
+  }
+
+  if (afl->formtrig_shm_path) {
+
+    shm_unlink((char *)afl->formtrig_shm_path);
+    ck_free(afl->formtrig_shm_path);
+    afl->formtrig_shm_path = NULL;
+
+  }
+
+  unsetenv(FORMTRIG_SHM_ENV_VAR);
+
+}
+
+void formtrig_prepare_run(afl_state_t *afl) {
+
+  if (!afl->formtrig_enabled || !afl->formtrig_shm_area) { return; }
+  formtrig_clear_record((formtrig_shm_record_t *)afl->formtrig_shm_area);
+
+}
