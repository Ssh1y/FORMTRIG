+  (void)formtrig_update_scalar_best(afl);
+
+}
+
+double formtrig_queue_weight_multiplier(const struct queue_entry *q) {
+
+  if (!q || !formtrig_guidance_eligible(&q->formtrig)) { return 1.0; }
+  if (!q->formtrig.stable) { return 1.0; }
+  if (q->formtrig.triggered) { return 16.0; }
+
+  double multiplier = 1.0;
+  u32    count = q->formtrig.component_count;
+  if (count > FORMTRIG_MAX_PROGRESS_COMPONENTS)
+    count = FORMTRIG_MAX_PROGRESS_COMPONENTS;
+
+  for (u32 i = 0; i < count; i++) {
+
+    const formtrig_progress_component_t *component =
+        &q->formtrig.components[i];
+    if (!formtrig_component_actionable(component)) { continue; }
+
+    double priority_scale = 32.0 / (double)(component->priority + 32u);
+    double confidence = component->confidence;
+    if (confidence > 1.0) { confidence = 1.0; }
+    if (confidence < 0.1) { confidence = 0.1; }
+
+    if (formtrig_component_lower(component)) {
+
+      multiplier += 8.0 * priority_scale * confidence /
+                    (1.0 + log2(component->value + 2.0));
+
+    } else if (formtrig_component_higher(component)) {
+
+      double progress = component->value > 64.0 ? 64.0 : component->value;
+      multiplier += 2.0 * priority_scale * confidence * log2(progress + 1.0);
+
+    }
+
+  }
+
+  if (multiplier > 16.0) { multiplier = 16.0; }
+  return multiplier;
+
+}
