+static u8 formtrig_component_actionable(
+    const formtrig_progress_component_t *c) {
+
+  if (!c || !(c->flags & FORMTRIG_COMPONENT_TC_ROOTED)) { return 0; }
+  if (!formtrig_finite(c->value)) { return 0; }
+  if (c->confidence <= 0.0) { return 0; }
+  /* Input influence selects mutation ranges. By itself it is supporting
