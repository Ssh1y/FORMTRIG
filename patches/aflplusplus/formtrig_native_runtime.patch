+static u8 formtrig_fuzz_one_env_truthy(const char *env) {
+
+  return env && env[0] &&
+         (env[0] == '1' || env[0] == 'y' || env[0] == 'Y' ||
+          env[0] == 't' || env[0] == 'T');
+
+}
+
+static u32 formtrig_fuzz_one_env_u32(const char *name, u32 fallback, u32 min,
+                                     u32 max) {
+
+  const char *env = getenv(name);
+  if (!env || !env[0]) { return fallback; }
+
+  char *end = NULL;
+  unsigned long value = strtoul(env, &end, 10);
+  if (end == env || *end || value < min || value > max) { return fallback; }
+  return (u32)value;
+
+}
+
+static u32 formtrig_typed_mutation_max(void) {
+
+  return formtrig_fuzz_one_env_u32("FORMTRIG_TYPED_MUTATION_MAX",
