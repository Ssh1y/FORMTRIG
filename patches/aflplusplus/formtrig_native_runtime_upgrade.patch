+static u8 formtrig_write_all_fd(int fd, const void *buf, size_t len) {
+
+  const u8 *bytes = (const u8 *)buf;
+  size_t    written = 0;
+  while (written < len) {
+
+    ssize_t ret = write(fd, bytes + written, len - written);
+    if (ret < 0) {
+
+      if (errno == EINTR) { continue; }
+      return 0;
+
+    }
+    if (!ret) { return 0; }
+    written += (size_t)ret;
+
+  }
+
+  return 1;
+
+}
+
+static u8 formtrig_write_all_to_file(const char *path, const u8 *buf,
+                                     u32 len) {
+
+  int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+  if (fd < 0) { return 0; }
+
+  if (!formtrig_write_all_fd(fd, buf, len)) {
+
+    close(fd);
+    return 0;
+
+  }
+
+  if (close(fd)) { return 0; }
+  return 1;
+
+}
+
+static u8 *formtrig_read_file_alloc(const char *path, u32 *out_len) {
+
+  *out_len = 0;
+  struct stat st;
+  if (stat(path, &st) || st.st_size <= 0 || st.st_size > MAX_FILE) {
+
+    return NULL;
+
+  }
+
+  u32 len = (u32)st.st_size;
+  u8 *buf = ck_alloc(len);
+  int fd = open(path, O_RDONLY);
+  if (fd < 0) {
+
+    ck_free(buf);
+    return NULL;
+
+  }
+
+  u32 got = 0;
+  while (got < len) {
+
+    ssize_t ret = read(fd, buf + got, len - got);
+    if (ret < 0) {
+
+      if (errno == EINTR) { continue; }
+      close(fd);
+      ck_free(buf);
+      return NULL;
+
+    }
+    if (!ret) { break; }
+    got += (u32)ret;
+
+  }
+
+  close(fd);
+  if (got != len) {
+
+    ck_free(buf);
+    return NULL;
+
+  }
+
+  *out_len = len;
+  return buf;
+
+}
