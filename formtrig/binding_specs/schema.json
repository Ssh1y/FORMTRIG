{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FORMTRIG BindingSpec",
  "type": "object",
  "additionalProperties": true,
  "required": ["tc_id", "tc", "atoms", "bindings"],
  "properties": {
    "tc_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "project": { "type": "string" },
        "binary": { "type": "string" },
        "command": { "type": "string" }
      }
    },
    "tc": {
      "type": "object",
      "additionalProperties": true,
      "required": ["category", "expression"],
      "properties": {
        "category": {
          "enum": [
            "numeric",
            "numeric-margin",
            "equality",
            "equality-magic",
            "binary-null",
            "binary-state-null",
            "lifecycle",
            "compound-sequence-lifecycle"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string"
        }
      }
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "expr", "kind", "root"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "expr": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "atom",
          "role",
          "expr",
          "observe_at",
          "component",
          "priority",
          "direction",
          "value_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "atom": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "root_observe",
              "guard",
              "producer",
              "desired_producer",
              "opposite_producer",
              "use",
              "lifecycle_event",
              "same_object",
              "input_influence"
            ]
          },
          "expr": {
            "type": "string",
            "minLength": 1
          },
          "observe_at": {
            "type": "object",
            "additionalProperties": true,
            "anyOf": [
              { "required": ["site_id"] },
              { "required": ["kind", "file", "line"] }
            ],
            "properties": {
              "site_id": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "opcode": {
                "type": "string"
              }
            }
          },
          "component": {
            "type": ["string", "integer"]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "enum": ["lower", "higher"]
          },
          "value_mode": {
            "enum": [
              "const",
              "distance",
              "hit",
              "outcome",
              "not_outcome",
              "a",
              "b",
              "c"
            ]
          },
          "value": {
            "type": ["number", "string"]
          },
          "confidence": {
            "type": ["number", "string"]
          },
          "phase_index": {
            "type": ["integer", "string"]
          }
        }
      }
    }
  }
}
