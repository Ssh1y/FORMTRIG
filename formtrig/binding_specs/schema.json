{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FORMTRIG BindingSpec",
  "type": "object",
  "additionalProperties": true,
  "required": ["tc_id", "tc", "atoms", "bindings"],
  "properties": {
    "tc_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "project": { "type": "string" },
        "binary": { "type": "string" },
        "command": { "type": "string" }
      }
    },
    "tc": {
      "type": "object",
      "additionalProperties": true,
      "required": ["category", "expression"],
      "properties": {
        "category": {
          "enum": [
            "numeric",
            "numeric-margin",
            "equality",
            "equality-magic",
            "binary-null",
            "binary-state-null",
            "lifecycle",
            "compound-sequence-lifecycle"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string"
        }
      }
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "expr", "kind", "root"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "expr": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "atom",
          "role",
          "expr",
          "observe_at",
          "component",
          "priority",
          "direction",
          "value_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "atom": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "root_observe",
              "guard",
              "producer",
              "desired_producer",
              "opposite_producer",
              "use",
              "lifecycle_event",
              "same_object",
              "input_influence",
              "repair_hook"
            ]
          },
          "expr": {
            "type": "string",
            "minLength": 1
          },
          "observe_at": {
            "type": "object",
            "additionalProperties": true,
            "anyOf": [
              { "required": ["site_id"] },
              { "required": ["kind", "file", "line"] },
              { "required": ["kind", "label"] },
              { "required": ["kind", "bug"] },
              { "required": ["kind", "canary_label"] }
            ],
            "properties": {
              "site_id": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "bug": {
                "type": "string",
                "minLength": 1
              },
              "canary_label": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "inst_no": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "opcode": {
                "type": "string"
              }
            }
          },
          "component": {
            "type": ["string", "integer"]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "enum": ["lower", "higher"]
          },
          "value_mode": {
            "enum": [
              "const",
              "distance",
              "hit",
              "outcome",
              "not_outcome",
              "a",
              "b",
              "c",
              "distance_to_a",
              "distance_to_b",
              "distance_to_c",
              "target_distance_a",
              "target_distance_b",
              "target_distance_c",
              "abs_to_a",
              "abs_to_b",
              "abs_to_c",
              "absent",
              "not_hit",
              "not-hit",
              "not_observed",
              "not-observed"
            ]
          },
          "relation_from": {
            "type": "string",
            "minLength": 1
          },
          "relation_to": {
            "type": "string",
            "minLength": 1
          },
          "object_expr": {
            "type": "string",
            "minLength": 1
          },
          "observe_window": {
            "enum": [
              "post_reach",
              "post-reach",
              "after_reach",
              "after-reach",
              "pre_reach",
              "pre-reach",
              "before_reach",
              "before-reach",
              "any"
            ]
          },
          "value": {
            "type": ["number", "string"]
          },
          "confidence": {
            "type": ["number", "string"]
          },
          "phase_index": {
            "type": ["integer", "string"]
          },
          "range_start": {
            "type": ["integer", "string"],
            "minimum": 0
          },
          "range_len": {
            "type": ["integer", "string"],
            "minimum": 1
          },
          "mutation_hint": {
            "enum": [
              "none",
              "default",
              "set_byte",
              "set-byte",
              "clear",
              "zero",
              "fill",
              "delete",
              "delete_like",
              "delete-like",
              "insert_byte",
              "insert-byte",
              "insert",
              "write_u16_le",
              "write-u16-le",
              "u16le",
              "write_u32_le",
              "write-u32-le",
              "u32le",
              "xor_byte",
              "xor-byte",
              "xor"
            ]
          },
          "mutation_value": {
            "type": ["integer", "string"],
            "minimum": 0
          },
          "mutation_hook": {
            "type": "string"
          },
          "typed_mutation_hook": {
            "type": "string"
          },
          "repair_hook_command": {
            "type": "string"
          },
          "repair_command": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": { "const": "same_object" }
              },
              "required": ["role"]
            },
            "then": {
              "required": ["relation_from", "relation_to", "object_expr"]
            }
          }
        ]
      }
    }
  }
}
